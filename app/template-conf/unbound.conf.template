server:
	trust-anchor-file: "/usr/share/dnssec-root/trusted-key.key"
	access-control: 0.0.0.0/0 allow
	access-control: ::/0 allow

	interface: 0.0.0.0@{PORT}
	interface: ::@{PORT}
	port: {PORT}

	#TLS
	# Interfaces / DNS over TLS
	interface: 0.0.0.0@{TLS_PORT}
	interface: ::@{TLS_PORT}
	tls-port: {TLS_PORT}

	tls-service-pem: "{TLS_SERVICE_PEM}"
	tls-service-key: "{TLS_SERVICE_KEY}"

	do-ip4: yes
	do-ip6: yes
	do-udp: yes
	do-tcp: yes
	tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"

python:

dynlib:

remote-control:
	control-enable: yes
	control-interface: /run/unbound.control.sock
